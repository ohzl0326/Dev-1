# ─── Database ────────────────────────────────────────────────────────────────
# Set automatically by Docker Compose. Override for external DB.
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@db:5432/career_tracker

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── OpenAI (required for AI suggestions) ───────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Notifications (optional — choose one or both) ───────────────────────────
# Telegram: create a bot via @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Scraping settings ───────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=12
PLAYWRIGHT_HEADLESS=true
REQUEST_DELAY_SECONDS=2.0

# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=false
